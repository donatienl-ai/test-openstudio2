# Copiez ces variables dans Render > votre service > Environment. Ne mettez jamais de vraie clé dans ce fichier.

# Site autorisé (CORS), sans barre finale. Plusieurs valeurs séparées par des virgules.
SITE_ORIGIN=https://openmedias.fr
# Adresse publique de ce serveur sur Render (sert à construire l'URL du webhook OpusClip).
PUBLIC_URL=https://openstudio-api.onrender.com

# OpusClip : la clé doit être la PREMIÈRE clé créée sur le compte (c'est elle qui signe les webhooks).
OPUSCLIP_API_KEY=
# Facultatif : uniquement si le compte appartient à plusieurs organisations.
OPUSCLIP_ORG_ID=
# Identifiants des 3 modèles de marque (sous-titres seuls, sans logo) : npm run templates
OPUS_TPL_IMPACT=
OPUS_TPL_CLASSIQUE=
OPUS_TPL_MINIMAL=
# buckets (tranches fixes documentées) ou free (intervalle libre, à activer seulement après un test concluant)
OPUS_DURATION_MODE=buckets
# 1 : si OpusClip refuse l'URL signée, le serveur lui envoie le fichier lui-même
OPUS_UPLOAD_FALLBACK=1

# Stockage Cloudflare R2 (ou AWS S3 : laisser STORAGE_ENDPOINT vide et mettre la région, ex. eu-west-3)
STORAGE_ENDPOINT=https://<ID_COMPTE>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=openstudio
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Limites (facultatif)
MAX_VIDEO_MB=10240
MAX_IMAGE_MB=15
MAX_JINGLE_MB=500
RENDER_TIMEOUT_MS=900000
DOWNLOAD_URL_TTL=86400

# Facultatif : mot de passe d'équipe pour les dépôts. Vide pendant la phase de tests internes.
ADMIN_SECRET=

# ---------- Emails automatiques (Mailjet) ----------
# Base PostgreSQL (Render Postgres : « Internal Database URL »). Vide : emails automatiques désactivés.
DATABASE_URL=
# require si l'URL utilisée est l'URL externe de Render
DATABASE_SSL=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=OpenMedias
# 1 : Mailjet valide la requête sans rien envoyer
MAILJET_SANDBOX=0
# Tests internes : tous les emails partent vers cette adresse. Obligatoire tant que MAIL_ALLOW_REAL_RECIPIENTS n'est pas à 1.
MAIL_REDIRECT_TO=
MAIL_ALLOW_REAL_RECIPIENTS=0
# Notification interne des demandes de devis (facultatif)
SALES_NOTIFY_EMAIL=
# Plage d'envoi des emails non transactionnels, heure de Paris
EMAIL_SEND_WINDOW=9-20
# 1 : relances et avis réservés aux contacts ayant donné leur consentement (règle à décider)
MARKETING_REQUIRE_CONSENT=0
# Identifiants des templates Mailjet (tant qu'ils sont vides, un contenu texte « [TEST] » est envoyé)
MJ_TPL_QUOTE_ACK=
MJ_TPL_QUOTE_INTERNAL=
MJ_TPL_ORDER_CONFIRM=
MJ_TPL_ORDER_REMINDER=
MJ_TPL_ACTIVATION_1=
MJ_TPL_ACTIVATION_2=
MJ_TPL_REVIEW=
# Fenêtre de dédoublonnage des demandes d'avis (jours)
REVIEW_DEDUP_DAYS=90
