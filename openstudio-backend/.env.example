# --- Serveur ---
PORT=3000
# URL publique du back-end sur Render (sert à construire l'URL du webhook OpusClip)
PUBLIC_BASE_URL=https://openstudio-backend.onrender.com
# Domaine(s) du site statique autorisé(s) à appeler l'API (séparés par des virgules)
FRONTEND_ORIGIN=https://openstudio.onrender.com

# --- Base de données (Render Postgres) ---
DATABASE_URL=postgres://user:password@host:5432/openstudio
# Mettre "false" en local si Postgres n'utilise pas SSL
DATABASE_SSL=true

# --- OpusClip ---
OPUSCLIP_API_KEY=sk-xxxxxxxxxxxxxxxx
# Clé secrète utilisée par OpusClip pour signer les webhooks.
# D'après la doc, c'est la clé API secrète (sk-...) — la PREMIÈRE créée si vous en avez plusieurs.
OPUSCLIP_WEBHOOK_SECRET=sk-xxxxxxxxxxxxxxxx
# true = construit et journalise les requêtes OpusClip sans les envoyer (aucun crédit consommé)
OPUSCLIP_DRY_RUN=true
# Tests : identifiants de clients (séparés par des virgules) dont les commandes partent réellement chez
# OpusClip malgré OPUSCLIP_DRY_RUN=true, pour des vidéos de OPUSCLIP_LIVE_MAX_MINUTES minutes au plus.
OPUSCLIP_LIVE_CLIENTS=
OPUSCLIP_LIVE_MAX_MINUTES=10
# Budget de crédits suivi localement (solde actuel du compte) et coût estimé par minute de vidéo
OPUSCLIP_CREDIT_BUDGET=3577
OPUSCLIP_CREDITS_PER_MINUTE=1
# Délai (secondes) entre deux vérifications d'un projet en cours (secours si le webhook n'arrive pas)
OPUSCLIP_POLL_INTERVAL_SEC=120
# Délai max avant de considérer un projet comme bloqué (minutes)
OPUSCLIP_TIMEOUT_MIN=240

# --- Stockage objet compatible S3 (Cloudflare R2 recommandé) ---
STORAGE_BUCKET=openstudio
# R2 : https://<ACCOUNT_ID>.r2.cloudflarestorage.com — AWS S3 : laisser vide
STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=xxxxxxxx
STORAGE_SECRET_KEY=xxxxxxxx
# Durée de validité des liens de téléchargement/aperçu (secondes)
DOWNLOAD_URL_TTL_SEC=900
# Durée de conservation des fichiers livrés (jours) avant purge automatique
FILE_RETENTION_DAYS=30

# --- Worker ---
WORKER_INTERVAL_SEC=10

# --- Liens d'accès des clients (envoyés par e-mail le jour de la diffusion) ---
# Adresse de l'espace client (par défaut : la première adresse de FRONTEND_ORIGIN)
CLIENT_SITE_URL=
# Mailjet : mêmes valeurs que sur l'ancien serveur server/
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=communication@openmedias.fr
MAILJET_FROM_NAME=OpenMedias
# Tests : tous les e-mails partent vers cette adresse. Obligatoire tant que MAIL_ALLOW_REAL_RECIPIENTS n'est pas à 1.
MAIL_REDIRECT_TO=
# Alertes à l'équipe pour les diffusions incomplètes (J-2, avancé au vendredi si week-end, et jour J)
TEAM_ALERT_EMAIL=communication@openmedias.fr

# --- Planning de diffusion (dashboard) ---
PLANNING_EXPORT_URL=https://openmedias-sales-dashboard.onrender.com/planning/api/openstudio/diffusions
# Même valeur que OPENSTUDIO_EXPORT_KEY côté dashboard
PLANNING_EXPORT_KEY=
PLANNING_SYNC_MIN=60

# --- Google Drive (dossiers des diffusions, vidéos déposées par les monteurs) ---
# Contenu complet du fichier de clé JSON du compte de service (une seule ligne)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Dossier (ou Drive partagé) partagé avec le compte de service : drive.google.com/drive/folders/<ID>
DRIVE_ROOT_FOLDER_ID=
DRIVE_SYNC_MIN=5
DRIVE_SETTLE_MIN=2
MAIL_ALLOW_REAL_RECIPIENTS=0
# 1 : Mailjet valide la requête sans rien envoyer
MAILJET_SANDBOX=0
# Modèle Mailjet du code d'accès (variables : nom, entreprise, lien, code, date_diffusion, credits_jusqu_au). Vide : e-mail texte simple.
MJ_TPL_CLIENT_ACCESS=
# Heure de Paris à partir de laquelle les liens du jour partent (jusqu'à 20 h)
CLIENT_ACCESS_SEND_HOUR=8

# --- Back-office de l'équipe (voir admin/README.md) ---
# Adresse du back-office, sans barre finale (CORS et liens d'activation)
ADMIN_ORIGIN=https://admin.openstudio.fr
# Clé de chiffrement des secrets de double authentification : 32 caractères minimum, ne jamais la changer
ADMIN_ENCRYPTION_KEY=
# Super admin créé au premier démarrage ; son lien d'activation est écrit dans les logs
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
# Durée d'une session (heures)
ADMIN_SESSION_HOURS=12
# Transition : ancien jeton technique (Authorization: Bearer <ADMIN_TOKEN>), droits admin.
# À supprimer avant la mise en production : seules les sessions du back-office resteront acceptées.
ADMIN_TOKEN=

# --- Mode test ---
# true : le client peut déposer lui-même une vidéo dans son espace (en production : false, l'équipe dépose)
CLIENT_UPLOADS_ENABLED=false
# Nom d'un client de test créé au démarrage ; son lien d'accès est écrit dans les logs. Vide en production.
TEST_CLIENT_NAME=

# --- Réseaux sociaux (Upload-Post) ---
# Clé API Upload-Post (tableau de bord Upload-Post → API Keys). Serveur uniquement.
UPLOAD_POST_API_KEY=
# Secret de signature des notifications (POST /api/uploadposts/users/webhook-secret, réponse « whsec_… »).
UPLOAD_POST_WEBHOOK_SECRET=
# Programmation possible jusqu'à N jours (7 max : durée de validité d'un lien signé du stockage)
SOCIAL_SCHEDULE_MAX_DAYS=7

# --- Légendes automatiques (API Claude) ---
ANTHROPIC_API_KEY=
# Modèle utilisé (défaut : claude-opus-5-5)
CAPTIONS_MODEL=claude-opus-5-5

# --- Paiement (Stripe Checkout) : « Confier ma vidéo à un monteur » ---
# Vide = paiement simulé (page de test, aucun prélèvement). Clé secrète sk_test_… puis sk_live_…
STRIPE_SECRET_KEY=
# Secret de signature des notifications Stripe (whsec_…), endpoint : <PUBLIC_BASE_URL>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# TVA appliquée aux prix HT (0.2 = 20 %)
VAT_RATE=0.2
