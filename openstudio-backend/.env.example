# --- Serveur ---
PORT=3000
# URL publique du back-end sur Render (sert à construire l'URL du webhook OpusClip)
PUBLIC_BASE_URL=https://openstudio-backend.onrender.com
# Domaine(s) du site statique autorisé(s) à appeler l'API (séparés par des virgules)
FRONTEND_ORIGIN=https://openstudio.onrender.com

# --- Base de données (Render Postgres) ---
DATABASE_URL=postgres://user:password@host:5432/openstudio
# Mettre "false" en local si Postgres n'utilise pas SSL
DATABASE_SSL=true

# --- OpusClip ---
OPUSCLIP_API_KEY=sk-xxxxxxxxxxxxxxxx
# Clé secrète utilisée par OpusClip pour signer les webhooks.
# D'après la doc, c'est la clé API secrète (sk-...) — la PREMIÈRE créée si vous en avez plusieurs.
OPUSCLIP_WEBHOOK_SECRET=sk-xxxxxxxxxxxxxxxx
# true = construit et journalise les requêtes OpusClip sans les envoyer (aucun crédit consommé)
OPUSCLIP_DRY_RUN=true
# Budget de crédits suivi localement (solde actuel du compte) et coût estimé par minute de vidéo
OPUSCLIP_CREDIT_BUDGET=3577
OPUSCLIP_CREDITS_PER_MINUTE=1
# Délai (secondes) entre deux vérifications d'un projet en cours (secours si le webhook n'arrive pas)
OPUSCLIP_POLL_INTERVAL_SEC=120
# Délai max avant de considérer un projet comme bloqué (minutes)
OPUSCLIP_TIMEOUT_MIN=240

# --- Stockage objet compatible S3 (Cloudflare R2 recommandé) ---
STORAGE_BUCKET=openstudio
# R2 : https://<ACCOUNT_ID>.r2.cloudflarestorage.com — AWS S3 : laisser vide
STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=xxxxxxxx
STORAGE_SECRET_KEY=xxxxxxxx
# Durée de validité des liens de téléchargement/aperçu (secondes)
DOWNLOAD_URL_TTL_SEC=900
# Durée de conservation des fichiers livrés (jours) avant purge automatique
FILE_RETENTION_DAYS=30

# --- Worker ---
WORKER_INTERVAL_SEC=10

# --- Administration (équipe) ---
# Jeton pour /api/admin/* (en-tête Authorization: Bearer <ADMIN_TOKEN>)
ADMIN_TOKEN=changez-moi-avec-une-longue-valeur-aleatoire

# --- Espace client ---
# true = le client peut déposer lui-même une vidéo depuis la page Capsules (POST /api/me/videos).
# Tests uniquement, à passer à false en production (les vidéos sont déposées par l'équipe OpenStudio).
CLIENT_UPLOADS_ENABLED=false
