{
  "name": "openstudio-backend",
  "version": "1.0.0",
  "description": "Back-end OpenStudio : commandes vidéo, intégration OpusClip, post-traitement ffmpeg et livraison des fichiers",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "opus:templates": "node scripts/list-templates.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "archiver": "^7.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "pg": "^8.12.0"
  }
}
